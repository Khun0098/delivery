# API em produção. Copie para .env e carregue no serviço (systemd, Docker, etc.).
NODE_ENV=production
TRUST_PROXY=1
API_PORT=4000
DB_PATH=/var/lib/delivery/delivery.db
UPLOAD_DIR=/var/lib/delivery/uploads
PUBLIC_API_URL=https://api.delivery.com.br
CLIENTE_ORIGIN=https://cliente.delivery.com.br
VENDEDOR_ORIGIN=https://vendedor.delivery.com.br
ADMIN_ORIGIN=https://admin.delivery.com.br
# Subdomínios do mesmo domínio => Lax funciona. Domínios totalmente diferentes exigem None (e HTTPS).
COOKIE_SAMESITE=Lax
TZ_OFFSET_HOURS=-3
# Pagamentos: "mock" é apenas para testes e NÃO deve ser usado em produção. Implemente seu gateway em apps/api/src/services/payments.js
PAYMENTS_PROVIDER=mock
PAYMENTS_WEBHOOK_SECRET=troque-por-um-segredo-longo-e-aleatorio
# Senhas do seed (use apenas ao criar o primeiro admin: npm run seed)
SEED_ADMIN_PASSWORD=
